# Shared measurement defaults for FlashMoE keep A/Bs (tool lane, 2026-11-15).
# Source from submit helpers:  set -a; source defaults.env; set +a
#
# Noise basis (hyb17-61377792, ROUNDS=5):
#   mean cand CV ≈ 3%
#   odd/even identity geo ≈ ±1%
#   recommended hard margin ≈ 1.0% (1.4% if using bootstrap×1.5)
# Dedicated identity job 61378923 may raise these further.

ROUNDS=8
WARMUP=2
RUNS=16
ERROR_MAX=0.25
SMOKE=1
TIMEOUT_S=180
BASE_TAG=HYB17
MIN_GEO_MARGIN_PCT=1.0
# Prefer beating HYB17; report HYB2/BK64 as extras.
KEEP_BASE=HYB17
