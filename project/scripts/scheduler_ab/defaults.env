# Shared measurement defaults for FlashMoE keep A/Bs (tool lane, 2026-11-15).
# Source from submit helpers:  set -a; source defaults.env; set +a
#
# Keep bar: see keep_bar.env (HYB17 confirmed; HYB22 noise-fragile / MARGINAL).

# shellcheck disable=SC1091
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/keep_bar.env"

ROUNDS=8
WARMUP=2
RUNS=16
ERROR_MAX=0.25
SMOKE=1
TIMEOUT_S=180
MIN_GEO_MARGIN_PCT=1.0
# Aggregation for keep gate (median matches main-lane keep CSVs).
AGG=${AGG:-median}
